{
  "manifest_version": 3,
  "name": "Vanhier Microsoft Login",
  "description": "Automatiseert Microsoft SSO voor ondersteunde applicaties.",
  "version": "1.1.0",
  "update_url": "https://vanhier-accountants-adviseurs.github.io/vanhier-chrome-sso-extensie/updates.xml",
  "content_scripts": [
    {
      "matches": [
        "https://connect.visma.com/*",
        "https://app.paytsoftware.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
